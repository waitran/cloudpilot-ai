# Run python3.12 scripts/init_env.py to generate an ignored local .env.
APP_NAME=CloudPilot AI
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:15173","http://127.0.0.1:15173"]
FRONTEND_PORT=15173
BACKEND_PORT=18080
POSTGRES_DB=cloudpilot
POSTGRES_USER=cloudpilot
POSTGRES_PASSWORD=
# Native development only; Compose supplies its own internal database address.
DATABASE_URL=

# Read-only collection. Set endpoints on the server, never through public source payloads.
# With the optional monitoring profile: PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_URL=
PROMETHEUS_TOKEN=
PROMETHEUS_PORT=19090
KUBE_MODE=disabled
# Explicitly mount your chosen configuration read-only via a local Compose override.
KUBE_CONFIG_FILE=
KUBE_CONTEXT=
